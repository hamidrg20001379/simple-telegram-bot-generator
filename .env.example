# Copy to .env. The Telegram wizard asks for these when they are blank.
# Do not commit .env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Central Telegram manager. Use a dedicated bot token, not a managed bot token.
MANAGER_TELEGRAM_BOT_TOKEN=
MANAGER_TELEGRAM_OWNER_IDS=668982499

# The Telegram wizard asks for this when it is blank. It creates one private
# repository per generated bot and pushes source to it.
# The token needs permission to create and write private repositories.
GITHUB_TOKEN=

# Optional Telegram API proxy prefix. Hermes-style proxy example:
# https://example.workers.dev/bot (the manager appends <TOKEN>/<method>)
TELEGRAM_API_BASE_URL=https://api.telegram.org/bot
